        "def precision_at_k(df, k):\n",
        "\n",
        "    values = []\n",
        "\n",
        "    for qid in df[\"question_id\"].unique():\n",
        "\n",
        "        qdf = (\n",
        "            df[df[\"question_id\"] == qid]\n",
        "            .sort_values(\"rank\")\n",
        "            .head(k)\n",
        "        )\n",
        "\n",
        "        labels = pd.to_numeric(\n",
        "            qdf[\"relevant\"],\n",
        "            errors=\"coerce\"\n",
        "        )\n",
        "\n",
        "        if labels.notna().sum() < k:\n",
        "            continue\n",
        "\n",
        "        precision = labels.sum() / k\n",
        "\n",
        "        values.append({\n",
        "            \"question_id\": qid,\n",
        "            f\"Precision@{k}\": round(precision, 4)\n",
        "        })\n",
        "\n",
        "    return pd.DataFrame(values)"
      ],
